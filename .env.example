# Copy to .env  ->  cp .env.example .env
# Never commit .env.
# Local-dev defaults target: `supabase start` (Postgres :54322) + `docker compose up -d` (Redis :6379).

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Clerk Auth (backend) ────────────────────────────────────────────────────
# Leave CLERK_PUBLISHABLE_KEY *and* CLERK_DOMAIN blank to keep the fixed dev user
# (app/core/clerk.py). Set either one to turn on real Clerk JWT verification —
# then every API call needs a valid `Authorization: Bearer <clerk token>`.
#
#   CLERK_PUBLISHABLE_KEY  → JWKS domain is derived from it (copy from frontend/.env.local)
#   CLERK_SECRET_KEY       → fetch the user's email/name on first login + webhook (copy from frontend/.env.local)
#   CLERK_WEBHOOK_SECRET   → verify POST /webhooks/clerk (from `clerk webhooks --forward-to ...`)
#   CLERK_DOMAIN           → optional explicit override, e.g. clerk.genie.ai
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_DOMAIN=
# JWKS is fetched from https://<derived-or-CLERK_DOMAIN>/.well-known/jwks.json

# ─── Database ────────────────────────────────────────────────────────────────
# LOCAL DEV — Supabase CLI stack (`supabase start`), the default `postgres`
# database. Genie's tables live in a dedicated `genie` SCHEMA (created by
# scripts/setup_supabase.sql) so Supabase Studio shows them and there's no clash
# with other local projects. The three-URL split only matters on Supabase Cloud.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL_POOL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL_SESSION=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
#
# PRODUCTION (Supabase Cloud — three modes, use the right one per CLAUDE.md §3):
# DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:PW@db.REF.supabase.co:5432/postgres
# DATABASE_URL_POOL=postgresql+asyncpg://postgres.REF:PW@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL_SESSION=postgresql+asyncpg://postgres.REF:PW@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase REST/client. Local defaults from `supabase status`; swap for the
# cloud project when deploying.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloud project (reference):
# SUPABASE_URL=https://bgvhepjbzkdfmvxndjmx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_h4wlkOeHDhjoRWuK0Jq57g_Prq0s2P2

# ─── Redis (ElastiCache / local) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
JWKS_CACHE_TTL_SECONDS=3600
CLERK_USER_CACHE_TTL_SECONDS=300

# ─── LLM (not required to boot; the active provider's key is required for /chat) ──
LLM_PROVIDER=openai            # openai | groq   (groq = credit-free testing)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=              # powers the Claude models in the composer's picker
ANTHROPIC_WORKSPACE_ID=        # only for identity-linked keys ("anthropic-workspace-id is required")
OPENAI_CHAT_MODEL=gpt-4o-2024-08-06
OPENAI_TITLE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # embeddings always stay on OpenAI

# Used only when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_UTILITY_MODEL=qwen/qwen3.8-27b             # enhancer / greeting / titles / validator

# ─── LangSmith (observability) ───────────────────────────────────────────────
# Set LANGSMITH_TRACING=true + a key to trace every LangGraph run. The backend
# pushes these into os.environ at startup (app/core/observability.py) — LangChain
# reads them from there, not from the Settings object. Legacy LANGCHAIN_* names
# also work.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=genie-dev

# ─── Search ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── MCP (only needed when a server runs standalone — CLAUDE.md §22) ──────────
TASKS_MCP_HOST=127.0.0.1
TASKS_MCP_PORT=8765

# ─── Google OAuth (Calendar agent only — Phase 3) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# ─── AWS — S3 + SQS (Knowledge-Base ingestion; local dev = LocalStack) ───────
# `docker compose up -d` starts LocalStack; the API auto-creates the bucket +
# queue on boot. Leave AWS_ENDPOINT_URL blank on real AWS (ECS IAM role).
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/genie-jobs
S3_BUCKET_NAME=genie-documents-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── Knowledge Base / RAG ingestion ─────────────────────────────────────────
RUN_INGESTION_WORKER=          # blank → on outside production; false → off; prod runs it as its own ECS service
INGESTION_CONCURRENCY=3
DOCUMENT_MAX_MB=25

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_TOKENS_PER_RUN=50000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
SUPERVISOR_MAX_TURNS=2          # how many times the supervisor may (re)plan per run
