# Copy to .env.local  ->  cp .env.local.example .env.local
#
# Clerk keys are managed by the Clerk CLI:
#   clerk auth login
#   clerk init --app app_3Ia08IpcDiBIMwI1FykjqEgLCMm
# which writes NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY into .env.local.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ─── Clerk (populated by `clerk init`) ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat
